---
import BaseLayout from "../layouts/BaseLayout.astro";
import registry from "../../../public-bundle/capabilities.json";
---
<BaseLayout title="What is public—and what is not" eyebrow="Capability registry" description="Every durable claim resolves to working public code, synthetic contract evidence, or an explicit private-only note.">
  <section class="section"><div class="legend"><span class="tag core">core · working code</span><span class="tag case-study">case study · contract evidence</span><span class="tag private-note">private note · explanation only</span></div><div class="capabilities">{registry.capabilities.map((capability) => <article id={capability.id}><div><span class={`tag ${capability.delivery}`}>{capability.delivery}</span><span class="maturity">{capability.maturity}</span></div><h2>{capability.title}</h2><p class="problem">{capability.problem}</p><p>{capability.summary}</p><details><summary>Public proof and references</summary><p><strong>Artifacts:</strong> {capability.public_artifacts.join(" · ")}</p><p><strong>Research IDs:</strong> {capability.research_refs.join(" · ")}</p><p><strong>Checked:</strong> {capability.last_verified}</p></details></article>)}</div></section>
</BaseLayout>
<style>.legend{display:flex;gap:.6rem;flex-wrap:wrap;margin-bottom:3rem}.capabilities{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line)}.capabilities article{background:var(--paper);padding:clamp(1.5rem,4vw,3rem);scroll-margin-top:100px}.capabilities article>div{display:flex;justify-content:space-between}.maturity{font:700 .65rem var(--mono);text-transform:uppercase;color:var(--muted)}.capabilities h2{font-size:clamp(2rem,3.5vw,3.2rem);margin-top:1.5rem}.problem{font-family:var(--serif);font-size:1.2rem}.capabilities article>p:last-of-type{color:var(--muted)}details{border-top:1px solid var(--line);padding-top:1rem;margin-top:1.5rem}summary{cursor:pointer;font-weight:700}details p{font-size:.8rem;font-family:var(--mono)}@media(max-width:750px){.capabilities{grid-template-columns:1fr}}</style>
