---
import BaseLayout from "../layouts/BaseLayout.astro";
const entries = [
  { date: "Jul 2026", title: "The end-date bug", body: "A human-inclusive sync date was sent directly to an exclusive API boundary. The request guaranteed that the current day was omitted. The fix was one line; proving every caller used it was the real work.", lesson: "Date semantics belong at the connector boundary." },
  { date: "Jul 2026", title: "A benchmark that tested its own assumptions", body: "The first robustness corpus promised deterministic behavior for cases the production rules intentionally delegated. The impressive failure count was largely a bad contract. I preserved the failed evidence and rebuilt the partition.", lesson: "A benchmark can be reproducible and still ask the wrong question." },
  { date: "Jul 2026", title: "The calibration pairing mistake", body: "Filtering predictions by confidence separated them from their original labels. Aggregate accuracy survived while bucket precision was wrong. The artifact was marked invalid and regenerated after order-invariance tests were added.", lesson: "Immutable evidence also needs an honest invalidation path." },
  { date: "Aug 2026", title: "Statements became evidence, not imports", body: "Manual entry was not enough for synced cards. A complete statement needed to reconcile the provider cycle, repair exact gaps, isolate ambiguity, and allow later provider rows to replace overlays.", lesson: "Source authority depends on the question and the time window." },
  { date: "Aug 2026", title: "The agent was not actually in the dashboard", body: "A workflow called an agent-shaped module, but Cloudflare had no native Agent run to observe. The system worked; the architecture claim did not. Native Durable Object execution and privacy-safe traces closed the gap.", lesson: "If the platform cannot see the agent, do not claim you built on its agent runtime." },
];
---
<BaseLayout title="The build log" eyebrow="Mistakes, investigations, changed decisions" description="The useful story is not that Ledgerglass always worked. It is that the failures were kept long enough to change the design.">
  <section class="section"><ol class="log">{entries.map((entry) => <li><time>{entry.date}</time><div><h2>{entry.title}</h2><p>{entry.body}</p><aside><span class="evidence-label">What I kept</span>{entry.lesson}</aside></div></li>)}</ol></section>
</BaseLayout>
<style>.log{list-style:none;margin:0;padding:0}.log li{display:grid;grid-template-columns:140px 1fr;gap:clamp(1rem,5vw,5rem);padding:4rem 0;border-top:1px solid var(--line)}time{font:700 .72rem var(--mono);color:var(--rust-dark);text-transform:uppercase}.log h2{font-size:clamp(2rem,4vw,3.7rem)}.log p{font-family:var(--serif);font-size:1.2rem;max-width:700px}.log aside{max-width:700px;border-left:3px solid var(--blue);padding:.8rem 1rem;margin-top:1.5rem}.log aside span{display:block;margin-bottom:.4rem}@media(max-width:650px){.log li{grid-template-columns:1fr;gap:.5rem}}</style>
